{
  "name": "honesty-mcp",
  "version": "0.2.1",
  "mcpName": "io.github.lkopietz3-byte/honesty-mcp",
  "description": "MCP server exposing the eleven-kit 'honesty SDK' family (grounding-kit, corroboration-kit, payout-invariance-kit, mutation-invariance-kit, trust-core, provenance-kit, claims-registry-kit, audit-chain-kit, advice-ledger-kit, agent-receipt-kit, cost-governor-kit) as tools any MCP-compatible coding agent can call while building or auditing a product.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "honesty",
    "grounding",
    "citation-checking",
    "trust",
    "provenance",
    "audit-log",
    "ai-safety",
    "coding-agent",
    "honesty-kits"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/honesty-mcp.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/honesty-mcp#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/honesty-mcp/issues"
  },
  "type": "module",
  "bin": {
    "honesty-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "smoke": "npm run build && node dist/smoke.js",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run stdio-probe && npm run verify:installed",
    "prepublishOnly": "npm run verify",
    "stdio-probe": "node scripts/stdio-probe.mjs",
    "verify:installed": "node scripts/verify-installed.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.0.0",
    "grounding-kit": "^0.2.0",
    "corroboration-kit": "^0.2.0",
    "payout-invariance-kit": "^0.2.0",
    "mutation-invariance-kit": "^0.2.0",
    "trust-core": "^0.2.0",
    "provenance-kit": "^0.2.0",
    "claims-registry-kit": "^0.3.0",
    "audit-chain-kit": "^0.2.0",
    "advice-ledger-kit": "^0.2.0",
    "agent-receipt-kit": "^0.2.0",
    "cost-governor-kit": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
